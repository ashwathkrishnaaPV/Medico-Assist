# MedicoAssist Environment Variables Template
# Copy this file to server/.env and provide strong deployment secrets.
# NEVER commit .env or raw credentials to source control.

PORT=3001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/campushealth
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_minimum_32_chars
JWT_EXPIRES_IN=1h
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ALLOW_LOCAL_JSON_FALLBACK=false

# AI Provider (Optional - OpenAI-compatible REST endpoint)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=15000

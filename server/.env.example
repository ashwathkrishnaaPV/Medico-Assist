# MedicoAssist Environment Variables Template
# Copy this file to .env and provide your deployment secrets.
# NEVER commit raw credentials or connection strings to source control.

PORT=3001
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campushealth?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
